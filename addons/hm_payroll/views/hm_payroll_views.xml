<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ Payslip ============================ -->

    <record id="hm_payslip_view_list" model="ir.ui.view">
        <field name="name">hm.payslip.list</field>
        <field name="model">hm.payslip</field>
        <field name="arch" type="xml">
            <list string="Payslips"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'">
                <field name="number"/>
                <field name="employee_id"/>
                <field name="structure_id" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="basic_wage" optional="hide" sum="Basic"/>
                <field name="gross_wage" sum="Gross"/>
                <field name="net_wage" sum="Net"/>
                <field name="run_id" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'done'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="hm_payslip_view_form" model="ir.ui.view">
        <field name="name">hm.payslip.form</field>
        <field name="model">hm.payslip</field>
        <field name="arch" type="xml">
            <form string="Payslip">
                <header>
                    <button name="action_compute_sheet" string="Compute"
                            type="object" invisible="state != 'draft'"
                            help="Rebuilds the lines from the structure's rules. Writes nothing to the ledger."/>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            help="Freezes the payslip and creates a draft journal entry for the accountant to post."/>
                    <button name="action_mark_paid" string="Mark Paid"
                            type="object" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'done')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="number" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="version_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="structure_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create_edit': True}"/>
                            <field name="run_id" readonly="1"/>
                        </group>
                        <group string="Period">
                            <field name="date_from"
                                   readonly="state != 'draft'"/>
                            <field name="date_to"
                                   readonly="state != 'draft'"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Summary">
                            <field name="basic_wage"/>
                            <field name="gross_wage"/>
                            <field name="net_wage" class="fw-bold"/>
                        </group>
                        <group string="Accounting"
                               groups="account.group_account_user">
                            <field name="move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="1">
                                <list string="Payslip Lines">
                                    <field name="sequence"
                                           column_invisible="True"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="quantity" optional="hide"/>
                                    <field name="rate" optional="show"/>
                                    <field name="amount" optional="show"/>
                                    <field name="total" sum="Total"/>
                                    <field name="currency_id"
                                           column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Inputs" name="inputs">
                            <field name="input_line_ids"
                                   readonly="state != 'draft'">
                                <list string="Other Inputs" editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="amount"/>
                                    <field name="currency_id"
                                           column_invisible="True"/>
                                </list>
                            </field>
                            <div class="alert alert-info" role="status">
                                Inputs reach the rules as
                                <code>inputs.get('CODE', 0.0)</code>.
                                Recompute the payslip after changing them.
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hm_payslip_view_search" model="ir.ui.view">
        <field name="name">hm.payslip.search</field>
        <field name="model">hm.payslip</field>
        <field name="arch" type="xml">
            <search string="Payslips">
                <field name="number"/>
                <field name="employee_id"/>
                <field name="structure_id"/>
                <field name="run_id"/>
                <separator/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Confirmed"
                        domain="[('state', '=', 'done')]"/>
                <filter name="paid" string="Paid"
                        domain="[('state', '=', 'paid')]"/>
                <group name="group_by">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_structure" string="Structure"
                            context="{'group_by': 'structure_id'}"/>
                    <filter name="group_run" string="Batch"
                            context="{'group_by': 'run_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hm_payslip" model="ir.actions.act_window">
        <field name="name">Payslips</field>
        <field name="res_model">hm.payslip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hm_payslip_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a payslip</p>
            <p>Pick an employee and a salary structure, then Compute.
               Nothing reaches the ledger until the slip is confirmed and
               its entry posted.</p>
        </field>
    </record>

    <!-- ============================= Batch ============================= -->

    <record id="hm_payslip_run_view_list" model="ir.ui.view">
        <field name="name">hm.payslip.run.list</field>
        <field name="model">hm.payslip.run</field>
        <field name="arch" type="xml">
            <list string="Payslip Batches">
                <field name="name"/>
                <field name="structure_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="slip_count" string="Payslips"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="hm_payslip_run_view_form" model="ir.ui.view">
        <field name="name">hm.payslip.run.form</field>
        <field name="model">hm.payslip.run</field>
        <field name="arch" type="xml">
            <form string="Payslip Batch">
                <header>
                    <button name="action_open_generate"
                            string="Generate Payslips" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm_all" string="Confirm All"
                            type="object" invisible="state != 'draft'"
                            confirm="Confirm every draft payslip in this batch and create their journal entries?"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"
                                   placeholder="January 2026 Salaries"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="structure_id"
                                   readonly="slip_count > 0"
                                   options="{'no_create_edit': True}"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_from"
                                   readonly="slip_count > 0"/>
                            <field name="date_to"
                                   readonly="slip_count > 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payslips" name="payslips">
                            <field name="slip_ids" readonly="1">
                                <list string="Payslips">
                                    <field name="number"/>
                                    <field name="employee_id"/>
                                    <field name="gross_wage"/>
                                    <field name="net_wage" sum="Net"/>
                                    <field name="currency_id"
                                           column_invisible="True"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-warning="state == 'done'"
                                           decoration-success="state == 'paid'"
                                           decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hm_payslip_run" model="ir.actions.act_window">
        <field name="name">Payslip Batches</field>
        <field name="res_model">hm.payslip.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================== Structure =========================== -->

    <record id="hm_payroll_structure_view_list" model="ir.ui.view">
        <field name="name">hm.payroll.structure.list</field>
        <field name="model">hm.payroll.structure</field>
        <field name="arch" type="xml">
            <list string="Salary Structures">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="type_id"/>
                <field name="journal_id"/>
            </list>
        </field>
    </record>

    <record id="hm_payroll_structure_view_form" model="ir.ui.view">
        <field name="name">hm.payroll.structure.form</field>
        <field name="model">hm.payroll.structure</field>
        <field name="arch" type="xml">
            <form string="Salary Structure">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"
                                   placeholder="Monthly Salaries"/></h1>
                        <h3><field name="code" placeholder="Reference"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="type_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="journal_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rules" name="rules">
                            <field name="rule_ids">
                                <list string="Salary Rules">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="amount_select"/>
                                    <field name="appears_on_payslip"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hm_payroll_structure" model="ir.actions.act_window">
        <field name="name">Salary Structures</field>
        <field name="res_model">hm.payroll.structure</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================= Rule ============================== -->

    <record id="hm_salary_rule_view_form" model="ir.ui.view">
        <field name="name">hm.salary.rule.form</field>
        <field name="model">hm.salary.rule</field>
        <field name="arch" type="xml">
            <form string="Salary Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Basic Salary"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="structure_id" readonly="1"
                                   invisible="not structure_id"/>
                            <field name="appears_on_payslip"/>
                        </group>
                    </group>
                    <group string="Condition">
                        <field name="condition_select"/>
                        <field name="condition_python"
                               invisible="condition_select != 'python'"
                               required="condition_select == 'python'"/>
                    </group>
                    <group string="Amount">
                        <field name="amount_select"/>
                        <field name="amount_fix"
                               invisible="amount_select != 'fix'"/>
                        <field name="amount_percentage"
                               invisible="amount_select != 'percentage'"/>
                        <field name="amount_percentage_base"
                               invisible="amount_select != 'percentage'"
                               required="amount_select == 'percentage'"/>
                        <field name="amount_python"
                               invisible="amount_select != 'code'"
                               required="amount_select == 'code'"/>
                    </group>
                    <group string="Accounting">
                        <field name="account_debit_id"
                               options="{'no_create': True}"/>
                        <field name="account_credit_id"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Description">
                        <field name="note" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================ Category =========================== -->

    <record id="hm_salary_rule_category_view_list" model="ir.ui.view">
        <field name="name">hm.salary.rule.category.list</field>
        <field name="model">hm.salary.rule.category</field>
        <field name="arch" type="xml">
            <list string="Salary Rule Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="action_hm_salary_rule_category" model="ir.actions.act_window">
        <field name="name">Rule Categories</field>
        <field name="res_model">hm.salary.rule.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ============================ Wizard ============================= -->

    <record id="hm_payslip_generate_view_form" model="ir.ui.view">
        <field name="name">hm.payslip.generate.form</field>
        <field name="model">hm.payslip.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Payslips">
                <group>
                    <field name="run_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                </group>
                <p class="text-muted">
                    One draft payslip per employee, computed immediately.
                    Employees who already have a payslip in this batch are
                    skipped.
                </p>
                <footer>
                    <button name="action_generate" string="Generate"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================= Menus ============================= -->

    <menuitem id="menu_hm_payroll_root" name="Payroll"
              sequence="86" groups="hm_payroll.group_payroll_user"/>
    <menuitem id="menu_hm_payslip" name="Payslips"
              parent="menu_hm_payroll_root" action="action_hm_payslip"
              sequence="10"/>
    <menuitem id="menu_hm_payslip_run" name="Batches"
              parent="menu_hm_payroll_root" action="action_hm_payslip_run"
              sequence="20"/>
    <menuitem id="menu_hm_payroll_config" name="Configuration"
              parent="menu_hm_payroll_root" sequence="90"
              groups="hm_payroll.group_payroll_manager"/>
    <menuitem id="menu_hm_payroll_structure" name="Salary Structures"
              parent="menu_hm_payroll_config"
              action="action_hm_payroll_structure" sequence="10"/>
    <menuitem id="menu_hm_salary_rule_category" name="Rule Categories"
              parent="menu_hm_payroll_config"
              action="action_hm_salary_rule_category" sequence="20"/>

</odoo>

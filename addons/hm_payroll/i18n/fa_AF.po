#. module: hm_payroll
#. odoo-python
#: code:addons/hm_payroll/models/hm_payslip.py:0
msgid "%s left draft; its inputs are frozen. Reset the payslip to draft first."
msgstr "%s از حالت مسوده خارج شده؛ ورودی‌های آن قفل است. نخست فیش معاش را به مسوده بازگردانید."

#. module: hm_payroll
#. odoo-python
#: code:addons/hm_payroll/models/hm_payslip.py:0

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hm_expiry_document_view_list" model="ir.ui.view">
        <field name="name">hm.expiry.document.list</field>
        <field name="model">hm.expiry.document</field>
        <field name="arch" type="xml">
            <list string="Documents"
                  decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'"
                  decoration-muted="state in ('renewed', 'cancelled')">
                <field name="type_id"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="subject" optional="show"/>
                <field name="date_issue" optional="hide"/>
                <field name="date_expiry"/>
                <field name="days_to_expiry" string="Days Left"/>
                <field name="responsible_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"
                       decoration-muted="state in ('renewed', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="hm_expiry_document_view_form" model="ir.ui.view">
        <field name="name">hm.expiry.document.form</field>
        <field name="model">hm.expiry.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_renew" string="Renew" type="object"
                            class="btn-primary"
                            invisible="state in ('renewed', 'cancelled')"
                            help="Opens a replacement and closes this one."/>
                    <button name="action_mark_cancelled" string="Cancel"
                            type="object"
                            invisible="state in ('renewed', 'cancelled')"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state not in ('renewed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired"
                            bg_color="text-bg-danger"
                            invisible="state != 'expired'"/>
                    <div class="oe_title">
                        <label for="type_id"/>
                        <h1><field name="type_id"
                                   options="{'no_create_edit': True}"/></h1>
                        <h2><field name="name" placeholder="Document number"/></h2>
                    </div>
                    <group>
                        <group string="Held By">
                            <field name="partner_id"/>
                            <field name="subject"
                                   placeholder="Or a vehicle, a building, the company"/>
                            <field name="responsible_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Validity">
                            <field name="date_issue"/>
                            <field name="date_expiry"/>
                            <field name="days_to_expiry"/>
                            <field name="issuing_authority"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'expiring'">
                        This expires in <field name="days_to_expiry"
                                               class="oe_inline fw-bold"/> day(s).
                    </div>

                    <group string="Renewal" name="renewal"
                           invisible="not renewed_from_id and not renewal_ids">
                        <field name="renewed_from_id" readonly="1"/>
                        <field name="renewal_ids" readonly="1" widget="many2many_tags"/>
                    </group>

                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <field name="manual_state" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hm_expiry_document_view_search" model="ir.ui.view">
        <field name="name">hm.expiry.document.search</field>
        <field name="model">hm.expiry.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name"/>
                <field name="type_id"/>
                <field name="partner_id"/>
                <field name="subject"/>
                <field name="responsible_id"/>
                <separator/>
                <filter name="expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="expiring" string="Expiring Soon"
                        domain="[('state', '=', 'expiring')]"/>
                <filter name="attention" string="Needs Attention"
                        domain="[('state', 'in', ('expiring', 'expired'))]"/>
                <filter name="valid" string="Valid"
                        domain="[('state', '=', 'valid')]"/>
                <separator/>
                <filter name="mine" string="My Responsibility"
                        domain="[('responsible_id', '=', uid)]"/>
                <separator/>
                <filter name="expiry_date" string="Expiry Date"
                        date="date_expiry"/>
                <group name="group_by">
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_responsible" string="Responsible"
                            context="{'group_by': 'responsible_id'}"/>
                    <filter name="group_expiry" string="Expires"
                            context="{'group_by': 'date_expiry'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hm_expiry_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">hm.expiry.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_attention': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Track a document that expires</p>
            <p>Licences, permits, visas, insurance, registrations,
               certifications. Whoever is named as responsible gets an activity
               before it lapses, so it does not depend on somebody remembering
               to open a spreadsheet.</p>
        </field>
    </record>

    <!-- ============================== Types ============================= -->

    <record id="hm_expiry_document_type_view_list" model="ir.ui.view">
        <field name="name">hm.expiry.document.type.list</field>
        <field name="model">hm.expiry.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="validity_months"/>
                <field name="reminder_days"/>
                <field name="requires_number"/>
                <field name="document_count" string="Documents"/>
                <field name="expiring_count" string="Need Attention"/>
            </list>
        </field>
    </record>

    <record id="hm_expiry_document_type_view_form" model="ir.ui.view">
        <field name="name">hm.expiry.document.type.form</field>
        <field name="model">hm.expiry.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-id-card-o">
                            <field name="document_count" widget="statinfo"
                                   string="Documents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Work Permit"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="validity_months"/>
                            <field name="reminder_days"/>
                        </group>
                        <group>
                            <field name="requires_number"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hm_expiry_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">hm.expiry.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a document type</p>
            <p>A type says how long a document is valid and how many days of warning you want. Set the types up once; the documents then look after themselves.</p>
        </field>
    </record>

    <!-- ============================== Menus ============================= -->

    <menuitem id="menu_hm_expiry_root" name="Documents" sequence="92"
              web_icon="hm_expiry_docs,static/description/icon.png"/>

    <menuitem id="menu_hm_expiry_document" name="Documents"
              parent="menu_hm_expiry_root"
              action="action_hm_expiry_document" sequence="10"/>

    <menuitem id="menu_hm_expiry_config" name="Configuration"
              parent="menu_hm_expiry_root" sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_hm_expiry_document_type" name="Document Types"
              parent="menu_hm_expiry_config"
              action="action_hm_expiry_document_type" sequence="10"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ List ============================== -->

    <record id="hm_timesheet_sheet_view_list" model="ir.ui.view">
        <field name="name">hm.timesheet.sheet.list</field>
        <field name="model">hm.timesheet.sheet</field>
        <field name="arch" type="xml">
            <list string="Timesheets"
                  decoration-muted="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'draft' and difference_hours &lt; 0">
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end" optional="hide"/>
                <field name="total_hours" widget="float_time" sum="Hours"/>
                <field name="expected_hours" widget="float_time" optional="show"/>
                <field name="difference_hours" widget="float_time" optional="show"
                       decoration-danger="difference_hours &lt; 0"
                       decoration-success="difference_hours &gt;= 0"/>
                <field name="approval_current_step" optional="hide" string="Awaiting"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================ Form ============================== -->

    <record id="hm_timesheet_sheet_view_form" model="ir.ui.view">
        <field name="name">hm.timesheet.sheet.form</field>
        <field name="model">hm.timesheet.sheet</field>
        <field name="arch" type="xml">
            <form string="Timesheet">
                <header>
                    <!-- Fields the button modifiers read. A modifier on a
                         field the view does not load silently evaluates to
                         false, so the buttons would never appear. -->
                    <field name="approval_can_act" invisible="1"/>
                    <field name="approval_request_id" invisible="1"/>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight"
                            invisible="not approval_can_act or state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="not approval_can_act or state != 'submitted'"/>
                    <button name="action_reset_draft" type="object" string="Reopen"
                            invisible="state not in ('submitted', 'rejected')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_entries" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="total_hours" widget="statinfo"
                                   string="Hours"/>
                        </button>
                        <button name="action_view_approval" type="object"
                                class="oe_stat_button" icon="fa-check-square-o"
                                invisible="not approval_request_id">
                            <div class="o_stat_info">
                                <field name="approval_state" class="o_stat_text"/>
                                <span class="o_stat_text">Approval</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end"/>
                            <field name="expected_hours" widget="float_time"/>
                            <field name="difference_hours" widget="float_time"
                                   decoration-danger="difference_hours &lt; 0"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'submitted'">
                        This timesheet has been submitted, so its entries can no
                        longer be changed. Reopen it to edit them.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'approved'">
                        Approved. The hours below are final; to change them,
                        the approval has to be cancelled first.
                    </div>
                    <notebook>
                        <page string="Entries" name="entries">
                            <field name="line_ids" readonly="state != 'draft'"
                                   context="{'default_employee_id': employee_id}">
                                <list string="Entries" editable="bottom">
                                    <field name="date"/>
                                    <field name="project_id"/>
                                    <field name="task_id"
                                           domain="[('project_id', '=', project_id)]"/>
                                    <field name="name" string="Description"/>
                                    <field name="unit_amount" widget="float_time"
                                           string="Hours" sum="Hours"/>
                                    <field name="employee_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- =========================== Searching =========================== -->

    <record id="hm_timesheet_sheet_view_search" model="ir.ui.view">
        <field name="name">hm.timesheet.sheet.search</field>
        <field name="model">hm.timesheet.sheet</field>
        <field name="arch" type="xml">
            <search string="Timesheets">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_start"/>
                <filter name="my_timesheets" string="My Timesheets"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve" string="Waiting on Me"
                        domain="[('state', '=', 'submitted')]"/>
                <separator/>
                <filter name="state_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="state_submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="state_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="short_week" string="Short of Expected"
                        domain="[('difference_hours', '&lt;', 0)]"/>
                <group name="group_by">
                    <filter name="groupby_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="groupby_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="groupby_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="groupby_week" string="Week"
                            context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =========================== Actions ============================= -->

    <record id="action_hm_timesheet_sheet_my" model="ir.actions.act_window">
        <field name="name">My Timesheets</field>
        <field name="res_model">hm.timesheet.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_timesheets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start this week's timesheet</p>
            <p>Record what you worked on, then submit the week for approval.
               Once it is submitted the entries are locked, so the hours your
               manager signs off are the hours you sent.</p>
        </field>
    </record>

    <record id="action_hm_timesheet_sheet_all" model="ir.actions.act_window">
        <field name="name">All Timesheets</field>
        <field name="res_model">hm.timesheet.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No timesheets yet</p>
            <p>A timesheet appears here as soon as somebody logs time, one per
               employee per week.</p>
        </field>
    </record>

    <record id="action_hm_timesheet_sheet_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">hm.timesheet.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting</p>
            <p>Submitted timesheets appear here until they are approved or
               sent back.</p>
        </field>
    </record>

    <!-- ============================ Menus ============================== -->

    <menuitem id="menu_hm_timesheet_root"
              name="Timesheets"
              web_icon="hm_timesheet,static/description/icon.png"
              sequence="72"/>

    <menuitem id="menu_hm_timesheet_my"
              name="My Timesheets"
              parent="menu_hm_timesheet_root"
              action="action_hm_timesheet_sheet_my"
              sequence="10"/>

    <menuitem id="menu_hm_timesheet_to_approve"
              name="To Approve"
              parent="menu_hm_timesheet_root"
              action="action_hm_timesheet_sheet_to_approve"
              sequence="20"
              groups="hr_timesheet.group_hr_timesheet_approver"/>

    <menuitem id="menu_hm_timesheet_all"
              name="All Timesheets"
              parent="menu_hm_timesheet_root"
              action="action_hm_timesheet_sheet_all"
              sequence="30"
              groups="hr_timesheet.group_hr_timesheet_approver"/>

</odoo>

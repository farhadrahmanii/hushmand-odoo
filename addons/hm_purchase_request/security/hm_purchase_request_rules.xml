<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          A requester sees their own requests. Anyone who has to act on one is
          either in purchasing or is named as an approver, and approvers reach
          the document through their activity, which carries its own access.
        -->
        <record id="rule_hm_purchase_request_own" model="ir.rule">
            <field name="name">Purchase requests: own requests</field>
            <field name="model_id" ref="model_hm_purchase_request"/>
            <field name="domain_force">['|', ('requester_id', '=', user.id), ('approval_request_id.line_ids.approver_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_hm_purchase_request_all" model="ir.rule">
            <field name="name">Purchase requests: purchasing sees all</field>
            <field name="model_id" ref="model_hm_purchase_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
        </record>
    </data>
</odoo>

msgstr "تنها یک دوره بسته‌شده بازگشایی شده می‌تواند."

#. module: af_dual_currency
#. odoo-python
#: code:addons/af_dual_currency/models/af_exchange_period.py:0
msgid "Only a confirmed period can be closed."
msgstr "تنها یک دوره تأییدشده بسته شده می‌تواند."

#. module: af_dual_currency
#. odoo-python
#: code:addons/af_dual_currency/models/af_exchange_period.py:0

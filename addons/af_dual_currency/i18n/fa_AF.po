#. module: af_dual_currency
#. odoo-python
#: code:addons/af_dual_currency/models/af_exchange_period.py:0
msgid "%s is closed. Reopen it before changing the rate, and be aware that anything already reported using it will no longer match."
msgstr "%s بسته است. پیش از تغییر نرخ آن را بازگشایی کنید، و توجه داشته باشید که هر گزارشی که قبلاً با این نرخ ارائه شده دیگر مطابقت نخواهد داشت."

#. module: af_dual_currency
#. odoo-python
#: code:addons/af_dual_currency/models/af_exchange_period.py:0
msgid "A closed period cannot be deleted."
msgstr "دوره بسته‌شده حذف شده نمی‌تواند."

#. module: af_dual_currency
#: model:ir.model.fields,help:af_dual_currency.field_af_exchange_period__name
msgid "A label for the period, for example 2026-08 or Sunbula 1405."
msgstr "برچسبی برای دوره، مثلاً ۲۰۲۶-۰۸ یا سنبله ۱۴۰۵."

#. module: af_dual_currency
#: model:ir.model.constraint,message:af_dual_currency.constraint_af_exchange_period_date_order
msgid "A period cannot end before it starts."
msgstr "دوره پیش از آغازش پایان یافته نمی‌تواند."

#. module: af_dual_currency

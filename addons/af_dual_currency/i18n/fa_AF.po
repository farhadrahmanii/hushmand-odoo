#. module: af_dual_currency
#: model:ir.model.fields,help:af_dual_currency.field_account_bank_statement_line__af_amount_total_secondary
#: model:ir.model.fields,help:af_dual_currency.field_account_move__af_amount_total_secondary
msgid "The document total converted at the rate agreed for its period. Zero means no confirmed period covers this date."
msgstr "مجموع سند که به نرخ توافق‌شده دوره آن تبدیل شده است. صفر یعنی هیچ دوره تأییدشده‌ای این تاریخ را پوشش نمی‌دهد."

#. module: af_dual_currency
#: model:ir.model.fields,help:af_dual_currency.field_account_bank_statement_line__af_exchange_period_id
#: model:ir.model.fields,help:af_dual_currency.field_account_move__af_exchange_period_id
msgid "The period whose rate was used for the second-currency total."
msgstr "دوره‌ای که نرخ آن برای مجموع اسعار دوم استفاده شد."

#. module: af_dual_currency
#: model:ir.model.constraint,message:af_dual_currency.constraint_af_exchange_period_rate_positive

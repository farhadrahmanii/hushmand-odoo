<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hm_contract" model="ir.sequence">
            <field name="name">Service Contract</field>
            <field name="code">hm.contract</field>
            <field name="prefix">SC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cron_contracts" model="ir.cron">
            <field name="name">Contracts: renewals and invoices due</field>
            <field name="model_id" ref="model_hm_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

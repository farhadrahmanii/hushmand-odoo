<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hm_contract_view_list" model="ir.ui.view">
        <field name="name">hm.contract.list</field>
        <field name="model">hm.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts"
                  decoration-warning="state == 'expiring'"
                  decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="contract_type" optional="show"/>
                <field name="recurrence"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end"/>
                <field name="date_next_invoice"/>
                <field name="amount_recurring" sum="Per Period"/>
                <field name="amount_annual" sum="Annualised" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'running'"
                       decoration-warning="state == 'expiring'"
                       decoration-muted="state in ('closed', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="hm_contract_view_form" model="ir.ui.view">
        <field name="name">hm.contract.form</field>
        <field name="model">hm.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_invoice" string="Create Invoice"
                            type="object" class="btn-primary"
                            invisible="state not in ('running', 'expiring') or contract_type != 'customer'"/>
                    <button name="action_renew" string="Renew" type="object"
                            invisible="state != 'expiring'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state in ('draft', 'closed', 'cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expiring"
                            bg_color="text-bg-warning"
                            invisible="state != 'expiring'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title"
                                   placeholder="Annual security services"/></h2>
                    </div>
                    <group>
                        <group string="Parties">
                            <field name="partner_id"/>
                            <field name="contract_type" widget="radio"/>
                            <field name="user_id"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Term">
                            <field name="date_start"/>
                            <field name="date_end"
                                   placeholder="Leave empty for open-ended"/>
                            <field name="recurrence"/>
                            <field name="date_next_invoice"
                                   invisible="contract_type != 'customer'"/>
                            <field name="auto_renew" invisible="not date_end"/>
                            <field name="notice_days" invisible="not date_end"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'expiring'">
                        This contract ends on <field name="date_end"
                                                     class="oe_inline fw-bold"/>.
                        Renew it or let it lapse — but decide before the date,
                        not after.
                    </div>

                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal" sum="Per Period"/>
                                    <field name="account_id" optional="hide"/>
                                    <field name="analytic_account_id" optional="hide"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_recurring"/>
                                <field name="amount_annual"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hm_contract_view_search" model="ir.ui.view">
        <field name="name">hm.contract.search</field>
        <field name="model">hm.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="running" string="Running"
                        domain="[('state', '=', 'running')]"/>
                <filter name="expiring" string="Expiring"
                        domain="[('state', '=', 'expiring')]"/>
                <filter name="mine" string="My Contracts"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="due" string="Invoice Due"
                        domain="[('state', 'in', ('running', 'expiring')), ('contract_type', '=', 'customer'), ('date_next_invoice', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="customer" string="We Provide"
                        domain="[('contract_type', '=', 'customer')]"/>
                <filter name="supplier" string="We Receive"
                        domain="[('contract_type', '=', 'supplier')]"/>
                <group name="group_by">
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_recurrence" string="Billing Cycle"
                            context="{'group_by': 'recurrence'}"/>
                    <filter name="group_user" string="Responsible"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hm_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hm.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a service contract</p>
            <p>Odoo Subscriptions is Enterprise, so a Community user with a
               maintenance agreement or an office lease has an invoice they
               remember to raise, or forget to. A contract knows when it is
               next due and raises the draft when you ask it to.</p>
        </field>
    </record>

    <record id="account_move_view_form_contract" model="ir.ui.view">
        <field name="name">account.move.form.inherit.hm.contracts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field name="hm_contract_id" invisible="not hm_contract_id"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_hm_contract"
              name="Contracts"
              parent="account.menu_finance_receivables"
              action="action_hm_contract"
              sequence="25"
              groups="account.group_account_invoice"/>

</odoo>

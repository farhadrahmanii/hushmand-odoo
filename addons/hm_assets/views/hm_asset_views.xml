<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================= Asset ============================= -->

    <record id="hm_asset_view_list" model="ir.ui.view">
        <field name="name">hm.asset.list</field>
        <field name="model">hm.asset</field>
        <field name="arch" type="xml">
            <list string="Fixed Assets"
                  decoration-muted="state in ('closed', 'cancelled')"
                  decoration-info="state == 'draft'">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="category_id" optional="show"/>
                <field name="date_start"/>
                <field name="purchase_value" sum="Purchase Value"/>
                <field name="depreciated_value" sum="Depreciated"/>
                <field name="book_value" sum="Book Value"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'running'"
                       decoration-muted="state in ('closed', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="hm_asset_view_form" model="ir.ui.view">
        <field name="name">hm.asset.form</field>
        <field name="model">hm.asset</field>
        <field name="arch" type="xml">
            <form string="Fixed Asset">
                <header>
                    <button name="action_compute_depreciation"
                            string="Compute Depreciation" type="object"
                            invisible="state == 'closed'"
                            help="Rebuilds the forecast. Posted periods are never touched."/>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'running'"
                            confirm="Closing removes any unposted periods. Posted entries stay in the ledger. Continue?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'running')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="posted_count == 0">
                            <field name="posted_count" widget="statinfo"
                                   string="Posted"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Toyota Hilux, 2026"/></h1>
                        <h3><field name="code" placeholder="Reference"/></h3>
                    </div>
                    <group>
                        <group string="Asset">
                            <field name="category_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="partner_id"/>
                            <field name="date_start"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Value">
                            <field name="purchase_value"
                                   readonly="state != 'draft'"/>
                            <field name="salvage_value"
                                   readonly="state != 'draft'"/>
                            <field name="depreciable_value"/>
                            <field name="depreciated_value"/>
                            <field name="book_value"/>
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="method" readonly="posted_count &gt; 0"/>
                            <field name="method_progress_factor"
                                   invisible="method != 'degressive'"
                                   readonly="posted_count &gt; 0"/>
                            <field name="period_length" readonly="posted_count &gt; 0"/>
                            <field name="period_count" readonly="posted_count &gt; 0"/>
                            <field name="prorata" readonly="posted_count &gt; 0"/>
                        </group>
                        <group string="Accounts">
                            <field name="account_asset_id"
                                   options="{'no_create': True}"/>
                            <field name="account_depreciation_id"
                                   options="{'no_create': True}"/>
                            <field name="account_expense_id"
                                   options="{'no_create': True}"/>
                            <field name="journal_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="status"
                         invisible="state != 'running' or pending_count == 0">
                        <field name="pending_count" class="oe_inline fw-bold"/>
                        period(s) are forecast but not posted. Nothing reaches
                        the ledger until you post it.
                    </div>

                    <notebook>
                        <page string="Depreciation" name="depreciation">
                            <field name="line_ids" readonly="1">
                                <list string="Periods"
                                      decoration-muted="posted"
                                      decoration-bf="not posted">
                                    <field name="sequence"/>
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="remaining_value"/>
                                    <field name="posted" widget="boolean_toggle"
                                           readonly="1"/>
                                    <field name="move_id" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <button name="action_post" type="object"
                                            string="Post" icon="fa-check"
                                            invisible="posted"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hm_asset_view_search" model="ir.ui.view">
        <field name="name">hm.asset.search</field>
        <field name="model">hm.asset</field>
        <field name="arch" type="xml">
            <search string="Fixed Assets">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="running" string="Running"
                        domain="[('state', '=', 'running')]"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="closed" string="Closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <!-- Expressed through line_ids rather than pending_count:
                     that field is computed and not stored, so it cannot be
                     searched. These stored terms mean the same thing. -->
                <filter name="pending" string="Has Unposted Periods"
                        domain="[('line_ids.posted', '=', False), ('state', '=', 'running')]"/>
                <filter name="due" string="Periods Due Now"
                        domain="[('line_ids.posted', '=', False), ('line_ids.date', '&lt;=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'running')]"/>
                <separator/>
                <group name="group_by">
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="In Service"
                            context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hm_asset" model="ir.actions.act_window">
        <field name="name">Fixed Assets</field>
        <field name="res_model">hm.asset</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a fixed asset</p>
            <p>Odoo Community has no asset management, so a vehicle you buy
               stays on the balance sheet at full value forever. This computes
               the depreciation schedule and posts it to the ledger — when you
               tell it to, never on its own.</p>
        </field>
    </record>

    <!-- ============================ Category ============================ -->

    <record id="hm_asset_category_view_list" model="ir.ui.view">
        <field name="name">hm.asset.category.list</field>
        <field name="model">hm.asset.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="name"/>
                <field name="method"/>
                <field name="period_length"/>
                <field name="period_count"/>
                <field name="asset_count" string="Assets"/>
            </list>
        </field>
    </record>

    <record id="hm_asset_category_view_form" model="ir.ui.view">
        <field name="name">hm.asset.category.form</field>
        <field name="model">hm.asset.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Vehicles"/></h1>
                    </div>
                    <group>
                        <group string="Default Schedule">
                            <field name="method"/>
                            <field name="method_progress_factor"
                                   invisible="method != 'degressive'"/>
                            <field name="period_length"/>
                            <field name="period_count"/>
                            <field name="prorata"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Default Accounts">
                            <field name="account_asset_id" options="{'no_create': True}"/>
                            <field name="account_depreciation_id" options="{'no_create': True}"/>
                            <field name="account_expense_id" options="{'no_create': True}"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        These are copied onto a new asset when the category is
                        chosen. Changing them later does not alter assets that
                        already exist.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hm_asset_category" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">hm.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============================= Menus ============================= -->

    <menuitem id="menu_hm_asset"
              name="Fixed Assets"
              parent="account.menu_finance_entries"
              action="action_hm_asset"
              sequence="30"
              groups="account.group_account_user"/>

    <menuitem id="menu_hm_asset_category"
              name="Asset Categories"
              parent="account.menu_finance_configuration"
              action="action_hm_asset_category"
              sequence="30"
              groups="account.group_account_manager"/>

</odoo>

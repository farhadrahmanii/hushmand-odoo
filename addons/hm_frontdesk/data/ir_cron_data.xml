<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_overnight_visitors" model="ir.cron">
            <field name="name">Front Desk: flag visitors never checked out</field>
            <field name="model_id" ref="model_hm_visitor"/>
            <field name="state">code</field>
            <field name="code">model._cron_flag_overnight_visitors()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

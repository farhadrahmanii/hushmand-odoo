<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="af_district_view_list" model="ir.ui.view">
        <field name="name">af.district.list</field>
        <field name="model">af.district</field>
        <field name="arch" type="xml">
            <list string="Districts">
                <field name="name"/>
                <field name="name_dr"/>
                <field name="name_ps"/>
                <field name="state_id"/>
                <field name="code" optional="hide"/>
                <field name="village_count" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="af_district_view_form" model="ir.ui.view">
        <field name="name">af.district.form</field>
        <field name="model">af.district</field>
        <field name="arch" type="xml">
            <form string="District">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="District name"/></h1>
                    </div>
                    <group>
                        <group string="Names">
                            <field name="name_dr"/>
                            <field name="name_ps"/>
                        </group>
                        <group string="Location">
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="code"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Villages" name="villages">
                            <field name="village_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="name_dr"/>
                                    <field name="name_ps"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="af_district_view_search" model="ir.ui.view">
        <field name="name">af.district.search</field>
        <field name="model">af.district</field>
        <field name="arch" type="xml">
            <search string="Districts">
                <field name="name"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('name_dr', 'ilike', self), ('name_ps', 'ilike', self)]"
                       string="District"/>
                <field name="state_id"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <!-- Odoo 19 dropped the expand and string attributes on a
                     search view's group; it is <group name="group_by"> now. -->
                <group name="group_by">
                    <filter name="group_state" string="Province" context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_af_district" model="ir.actions.act_window">
        <field name="name">Districts</field>
        <field name="res_model">af.district</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a district</p>
            <p>Afghanistan's 546 districts are loaded with this module, in
               English, Dari and Pashto. Add your own if you need one that
               is not listed.</p>
        </field>
    </record>

</odoo>

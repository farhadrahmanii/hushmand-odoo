<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="af_village_view_list" model="ir.ui.view">
        <field name="name">af.village.list</field>
        <field name="model">af.village</field>
        <field name="arch" type="xml">
            <list string="Villages" editable="bottom">
                <field name="name"/>
                <field name="name_dr"/>
                <field name="name_ps"/>
                <field name="district_id"/>
                <field name="state_id" optional="show"/>
                <field name="code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="af_village_view_form" model="ir.ui.view">
        <field name="name">af.village.form</field>
        <field name="model">af.village</field>
        <field name="arch" type="xml">
            <form string="Village">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Village name"/></h1>
                    </div>
                    <group>
                        <group string="Names">
                            <field name="name_dr"/>
                            <field name="name_ps"/>
                        </group>
                        <group string="Location">
                            <field name="district_id"/>
                            <field name="state_id"/>
                            <field name="code"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="af_village_view_search" model="ir.ui.view">
        <field name="name">af.village.search</field>
        <field name="model">af.village</field>
        <field name="arch" type="xml">
            <search string="Villages">
                <field name="name"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('name_dr', 'ilike', self), ('name_ps', 'ilike', self)]"
                       string="Village"/>
                <field name="district_id"/>
                <field name="state_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_district" string="District" context="{'group_by': 'district_id'}"/>
                    <filter name="group_state" string="Province" context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_af_village" model="ir.actions.act_window">
        <field name="name">Villages</field>
        <field name="res_model">af.village</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a village</p>
            <p>This list starts empty on purpose. No reliable public dataset of
               Afghan villages exists, so rather than ship invented data the
               module leaves it to you. Add the villages your organisation
               actually works in.</p>
        </field>
    </record>

</odoo>

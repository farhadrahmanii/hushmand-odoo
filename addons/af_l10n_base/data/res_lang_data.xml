<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Odoo ships Persian (fa_IR) and nothing else from this region: no Dari,
      no Pashto. Without these two records a customer cannot even select their
      own language, so the module creates them.

      Both are right-to-left, and both start the week on Saturday, which is the
      Afghan working week. Dates default to yyyy/mm/dd because that is how a
      Jalali date is written — install af_jalali alongside this module and the
      dates themselves become Jalali too.
    -->

    <record id="lang_fa_af" model="res.lang">
        <field name="name">Dari / دری</field>
        <field name="code">fa_AF</field>
        <field name="iso_code">fa_AF</field>
        <field name="url_code">fa_AF</field>
        <field name="direction">rtl</field>
        <field name="date_format">%Y/%m/%d</field>
        <field name="time_format">%H:%M:%S</field>
        <field name="week_start">6</field>
        <field name="decimal_point">.</field>
        <field name="thousands_sep">,</field>
        <field name="grouping">[3,0]</field>
        <field name="active" eval="False"/>
    </record>

    <record id="lang_ps_af" model="res.lang">
        <field name="name">Pashto / پښتو</field>
        <field name="code">ps_AF</field>
        <field name="iso_code">ps_AF</field>
        <field name="url_code">ps_AF</field>
        <field name="direction">rtl</field>
        <field name="date_format">%Y/%m/%d</field>
        <field name="time_format">%H:%M:%S</field>
        <field name="week_start">6</field>
        <field name="decimal_point">.</field>
        <field name="thousands_sep">,</field>
        <field name="grouping">[3,0]</field>
        <field name="active" eval="False"/>
    </record>

</odoo>

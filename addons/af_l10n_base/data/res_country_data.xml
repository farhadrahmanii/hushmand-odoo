<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Afghan postal addresses are written largest-to-smallest and normally
      include the district, which Odoo's default format has no place for.
      res_partner.py registers af_district_name and af_village_name with
      _formatting_address_fields, which is what makes these keys legal here.
    -->
    <record id="base.af" model="res.country">
        <field name="address_format">%(street)s
%(street2)s
%(af_village_name)s
%(af_district_name)s
%(city)s %(zip)s
%(state_name)s
%(country_name)s</field>
    </record>

</odoo>
